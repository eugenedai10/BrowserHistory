{
  "manifest_version": 3,
  "name": "Chrome History Logger",
  "version": "1.0.0",
  "description": "Logs browsing activity (visits, clicks, YouTube, Discord) to ~/chrome-history via a native host.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": [
    "tabs",
    "webNavigation",
    "idle",
    "nativeMessaging",
    "storage",
    "alarms",
    "notifications",
    "unlimitedStorage"
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "incognito": "spanning",
  "action": {
    "default_title": "History Logger",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/common.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "content/youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://discord.com/*"
      ],
      "js": [
        "content/discord.js"
      ],
      "run_at": "document_idle"
    }
  ]
}